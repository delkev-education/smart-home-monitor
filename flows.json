      [
        "debug_raw",
        "process_data"
      ]
    ]
  },
  {
    "id": "debug_raw",
    "type": "debug",
    "z": "tab_smart_home",
    "name": "Datos recibidos (JSON)",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 620,
    "y": 80,
    "wires": []
  },
  {
    "id": "process_data",
    "type": "function",
    "z": "tab_smart_home",
    "name": "Separar variables y responder",
    "func": "// Se espera un JSON con temperatura, gas, humedad_suelo, intrusion y energia.\\nconst d = msg.payload || {};\\nconst n = (v, fallback=0) => { const x = Number(v); return Number.isFinite(x) ? x : fallback; };\\nconst intrusion = d.intrusion === true || d.intrusion === 1 || String(d.intrusion).toLowerCase() === 'true' || String(d.intrusion) === '1' ? 'INTRUSIÓN DETECTADA' : 'Sin intrusión';\\nconst outputs = [\\n  { payload: n(d.temperatura) },\\n  { payload: n(d.gas) },\\n  { payload: n(d.humedad_suelo) },\\n  { payload: intrusion },\\n  { payload: n(d.energia) },\\n  { payload: { ok: true, recibido: new Date().toISOString(), variables: ['temperatura','gas','humedad_suelo','intrusion','energia'] } }\\n];\\nreturn outputs;",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 180,
    "wires": [
      [
        "gauge_temp"
      ],
      [
        "gauge_gas"
      ],
      [
        "chart_soil"
      ],
      [
        "text_intrusion"
      ],
      [
        "gauge_energy"
      ],
      [
        "http_response"
      ]
    ]
  },
